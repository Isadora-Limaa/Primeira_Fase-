programa {
  funcao inicio() {
  

//entendimento do problema
   // salário recebido e os dias trabalhados de junin, para saber o quanto recebe por dia.
   //informações e variáveis
   real salarioMensal, diasTrabalhados, salarioSemanal, total


   //entrada de dados
    escreva("quanto junin recebe por mês: ")
    leia(salarioMensal)
    escreva("quantos dias você trabalha por mês: ")
    leia(diasTrabalhados)


   //processamento
   total = salarioMensal / diasTrabalhados




   //saída
   escreva("você recebe por dia: R$ ")
   escreva(total)
  
  }
}
