programa {
  funcao inicio() {
  // entendimento
    // Romero e sua política de preços.

  // informações
  real custo_pago, lucro

  // entrada de dados
  escreva("Quanto Romero pagou pela obra: R$")
  leia(custo_pago)

  // processamento
  lucro = custo_pago * 2

  // mostrar resultado 
  escreva("Romero vai vender a obra por: R$" + lucro)
  }
}
