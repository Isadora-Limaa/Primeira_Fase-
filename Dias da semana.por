programa {
  funcao inicio() {
   inteiro dia

   escreva("Diga um número de 1 a 7: ")
   leia(dia)

   se (dia == 1){
    escreva("Domingo.")
   }

   se (dia == 2){
    escreva("Sábado.")
   }

   se (dia == 3){
    escreva("Segunda.")
   }

   se (dia == 4){
    escreva("Terça.")
   }

   se(dia == 5){
    escreva("Quarta.")
   }

   se(dia == 6){
    escreva("Quinta.")
   }

   se (dia == 7){
    escreva("Sexta.")
   }
  }
}