programa {
  funcao inicio() {
      //entendimento do problema
   //quantas laranjas tem no inicio e no final da fera.
   
    //informações e variáveis
    inteiro inLaranja, fnLaranja, vendas


    //entrada de dados
    escreva("quantas laranjas temos no inicio: ")
    leia(inLaranja)
    escreva("quantas laranjas temos no final: ")
    leia(fnLaranja)


    //processamento
    vendas = inLaranja - fnLaranja


    //saída
    escreva("quantas laranjas foram vendidas hoje: ")
    escreva(vendas)

  }
}
