programa {
  funcao inicio() {
     //entendimento do problema
     //calcular o valor de vales trocas, considerando o preço e quantidade
   
    //informações e variáveis
    inteiro  quantidade  
    real valeTroca, preco


    //entrada de dados
    escreva("preço do par de calçado: ")
    leia(preco)
    escreva("quantidade de calçados: ")
    leia(quantidade)


    //processamento
    valeTroca = preco * quantidade


    //saídas
    escreva("vale troca recebido R$ ")
    escreva(valeTroca)
 
  }
}
