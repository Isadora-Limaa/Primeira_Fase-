programa {
  funcao inicio() {
   

 //entendimento do problema
    //leitura de quantos clt, estagiário e pj tem na empresa. mostre a soma total de devs.
   //informações e variáveis
   inteiro pj, clt, estagiario, dev


   //entrada de dados
   escreva("quantos pj na empresa: ")
    leia(pj)
    escreva("quantos clts na empresa: ")
   leia(clt)
   escreva("quantos estagiarios na empresa: ")
   leia(estagiario)


   //processamento
   dev = pj + clt + estagiario


   //saída
   escreva("qual o total de funcionarios na empresa: ")
   escreva(dev)
 
  }
}
